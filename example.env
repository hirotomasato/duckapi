# DuckAI2API environment (copy to .env and edit)
# Bearer token required on /v1/chat/completions, /v1/responses, /v1/messages. Leave empty for open access.
DUCKAI_API_KEY=

# Duck.ai host (default https://duck.ai)
DUCKAI_BASE=https://duck.ai

# Proxy POOL for the browser. Comma-separated; rotate on ERR_BN_LIMIT bans.
# Duck.ai issues a PERSISTENT per-IP ban (418 ERR_BN_LIMIT on the first request)
# with no Retry-After / cooldown - the only fix is a pool of clean exits.
# Either set DUCKAI_PROXIES (pool) or DUCKAI_PROXY (single).
# residential / SOCKS5 proxies work best; datacenter IPs get banned fast.
DUCKAI_PROXIES=
# DUCKAI_PROXIES=http://user:pass@host1:port,http://host2:port,socks5://host3:port

# Page warmup. Duck.ai needs the first seconds of a fresh page to mint its
# challenge token; sending too early hits ERR_BN_LIMIT. WARM_MIN is a hard
# floor, WARM_MAX the deadline for the readiness poll. The old behaviour was a
# fixed 7s sleep on EVERY turn; the poll lets a fast page skip straight to ready
# and falls back to the full budget if the probe never goes green.
DUCKAI_WARM_MIN=2.0
DUCKAI_WARM_MAX=7.0

# "1" = launch Chrome and warm a page at server startup instead of on first
# request. Makes the first caller skip ~10s of setup; boot gets slower.
DUCKAI_PREWARM=1

# Chrome executable used by Playwright. Only needed if Chrome is installed
# somewhere non-standard or you want a different build.
# DUCKAI_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Default model if client omits one. Real Duck.ai backend ids:
#   gpt-5.6-luna, gpt-5.4, gpt-5.4-mini,
#   claude-sonnet-4-6, claude-haiku-4-5, claude-opus-4-8,
#   mistral-small-2603, tinfoil/gpt-oss-120b, tinfoil/gemma4-31b
# User aliases also work: gpt-5.6-sol -> gpt-5.6-luna, claude-3-haiku -> claude-haiku-4-5, etc.
DUCKAI_MODEL=gpt-5.6-luna

# "1" = start a fresh chat per request (stateless, OpenAI/Anthropic-like).
# "0" = reuse the session conversation across requests.
DUCKAI_NEW_CHAT=0

# Server port
PORT=8080

# "1" = enable experimental intent->tool synthesis routing (returns synthesized
# tool_calls without calling Duck.ai). OFF by default: agent clients (WorkBuddy,
# Claude Code) always send tools + huge context and mis-hits break the chat.
DUCKAI_TOOL_ROUTING=0
